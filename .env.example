# Server
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/atelier

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=pwhjxsj3
CLOUDINARY_API_KEY=835368388642438
CLOUDINARY_API_SECRET=SiQmHEnHTYcTl0MikIFZB4al-mE

# Razorpay (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket (https://app.shiprocket.in)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary

# Seed
SEED_ADMIN_EMAIL=admin@atelier.com
SEED_ADMIN_PASSWORD=Admin@12345

# Email — order confirmations with invoice PDFs, password resets, order updates.
# Leave SMTP_HOST empty in dev: emails are written to tmp/outbox/*.eml instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=unboxstore <no-reply@unboxstore.in>

# SMS for mobile OTP sign-in (Twilio). Leave empty in dev: the code is logged
# to the server console and shown on the sign-in screen.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Auth cookie. Keep "lax" when the storefront reaches the API on the same
# domain (e.g. via a rewrite). Use "none" if it calls the API cross-domain.
COOKIE_SAMESITE=lax
